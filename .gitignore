# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境（各组件各自建在自己目录下；.venv-rocm 这类带后缀的临时环境也要一起挡——
# uv venv 自己会在里面放一份 .gitignore 兜底，但别靠这个，仓库这一层也该挡住）
.venv/
.venv*/
venv/

# 打包产物（tools/package-bundle.ps1 的默认输出目录；产物是给别人的压缩包，不是给仓库的）
dist/

# 模型权重与缓存 —— 绝不进 git
models/
*.safetensors
*.gguf
*.bin

# 样例音频 —— 绝不进 git（用 scripts/make-sample.ps1 现生成）
samples/
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.webm

# 本地临时产物
.tmp/
*.log

# D0 generated corpora, engine output and local caches (source scripts stay tracked)
evaluation/document-parser/work/
